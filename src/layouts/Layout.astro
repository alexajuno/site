---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Widen the container for multi-column pages like the homepage. */
	wide?: boolean;
}

const { title = 'alexajuno', description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<div class:list={['mx-auto px-6 py-16', wide ? 'max-w-4xl' : 'max-w-2xl']}>
			<header class="mb-12">
				<a href="/" class="font-medium underline-offset-4 hover:underline">alexajuno</a>
			</header>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>
