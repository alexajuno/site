---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="That page does not exist.">
	<section class="mx-auto max-w-[680px] py-10">
		<h1 class="text-[2.125rem] font-semibold tracking-tight">nothing on the desk here</h1>
		<p class="mt-4 text-muted-foreground">
			<span class="font-mono text-date">{Astro.url.pathname}</span> isn't here. It may have moved, or it
			may never have existed.
		</p>
		<p class="mt-8 flex gap-6">
			<a href="/" class="text-link underline-offset-4 hover:underline">home</a>
			<a href="/blog" class="text-link underline-offset-4 hover:underline">writing</a>
		</p>
	</section>
</Layout>
