---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import YearHeading from '@/components/YearHeading.astro';
import { formatShortDate, getYear } from '@/lib/posts';

const bookmarks = (await getCollection('bookmarks')).sort(
	(a, b) => b.data.added.valueOf() - a.data.added.valueOf(),
);

const bookmarksByYear = Map.groupBy(bookmarks, (bookmark) => getYear(bookmark.data.added));
---

<Layout title="Bookmarks" description="Engineering links alexajuno found worth keeping.">
	<div class="mx-auto max-w-[720px]">
		<header>
			<h1 class="font-serif text-[2.125rem] font-semibold text-heading">bookmarks</h1>
			<p class="mt-1 text-[0.9375rem] text-muted-foreground">
				{bookmarks.length} {bookmarks.length === 1 ? 'link' : 'links'}
			</p>
		</header>

		{
			[...bookmarksByYear].map(([year, yearBookmarks]) => (
				<section>
					<YearHeading year={year} count={yearBookmarks.length} />
					<div class="flex flex-col">
						{yearBookmarks.map(({ data: { url, title, added, note } }) => (
							<a
								href={url}
								class="group -mx-3.5 flex flex-col gap-x-5 gap-y-0.5 rounded-sm px-3.5 py-2 transition-colors hover:bg-muted sm:flex-row sm:items-baseline"
							>
								<time
									datetime={added.toISOString()}
									class="shrink-0 font-mono text-[0.8125rem] text-date tabular-nums sm:w-14"
								>
									{formatShortDate(added)}
								</time>
								<span>
									<span class="text-foreground transition-colors group-hover:text-here-text">
										{title}
									</span>
									<span class="ml-2 rounded-sm bg-site-tint px-2 py-px text-xs text-site">
										{new URL(url).hostname}
									</span>
									{note && <span class="mt-1 block text-sm text-muted-foreground">{note}</span>}
								</span>
							</a>
						))}
					</div>
				</section>
			))
		}
	</div>
</Layout>
