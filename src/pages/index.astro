---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import { getSortedPosts } from '@/lib/posts';

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 6);

// The shelf earns its place beside the writing only once it holds a few links;
// with fewer, the writing takes the whole width.
const SHELF_MIN = 3;
const bookmarks = (await getCollection('bookmarks')).sort(
	(a, b) => b.data.added.valueOf() - a.data.added.valueOf(),
);
const shelf = bookmarks.length >= SHELF_MIN ? bookmarks.slice(0, 3) : [];
---

<Layout title="alexajuno" description="giao's little digital garden" hero>
	<p slot="hero" class="max-w-[440px] font-serif text-lg leading-relaxed text-pretty text-foreground sm:text-[1.1875rem]">
		hi, i'm a software developer. i spend most of my time with the computer and let the
		curiosity lead.
	</p>

	<div class:list={['grid gap-14', shelf.length > 0 && 'lg:grid-cols-[1fr_300px] lg:gap-18']}>
		<section>
			<SectionLabel>Writing</SectionLabel>
			<div class="flex flex-col divide-y divide-border/70">
				{recentPosts.map((post) => <PostRow post={post} />)}
			</div>
			<a href="/blog" class="mt-5 inline-block text-[0.9375rem] text-link hover:underline underline-offset-4">
				all {posts.length} posts →
			</a>
		</section>

		{
			shelf.length > 0 && (
				<section>
					<SectionLabel>On the shelf</SectionLabel>
					<div class="flex flex-col divide-y divide-border/70">
						{shelf.map(({ data: { url, title } }) => (
							<a href={url} class="group py-2.5">
								<span class="block text-foreground transition-colors group-hover:text-here-text">
									{title}
								</span>
								<span class="mt-1 inline-block rounded-sm bg-site-tint px-2 text-xs text-site">
									{new URL(url).hostname}
								</span>
							</a>
						))}
					</div>
					<a href="/bookmarks" class="mt-5 inline-block text-[0.9375rem] text-link hover:underline underline-offset-4">
						all bookmarks →
					</a>
				</section>
			)
		}
	</div>
</Layout>
