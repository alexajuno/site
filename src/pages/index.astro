---
import Layout from '../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import Prompt from '@/components/Prompt.astro';
import { getSortedPosts } from '@/lib/posts';

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 6);

const links = [
	{ label: 'github', href: 'https://github.com/alexajuno' },
	{ label: 'x', href: 'https://x.com/giolynx104' },
	{ label: 'email', href: 'mailto:giolynx104@gmail.com' },
];
---

<Layout wide title="alexajuno" description="giao's little digital garden">
	<section>
		<Prompt as="h1" command="whoami" label="About" />
		<p class="mt-4 max-w-prose text-pretty">
			hi, i'm a software developer. i spend most of my time with the computer and let the
			curiosity lead.
		</p>
		<ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm">
			{
				links.map(({ label, href }) => (
					<li>
						<a
							href={href}
							class="text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-14">
		<Prompt command="ls ~/blog" label="Blog" />
		<div class="mt-4 flex flex-col">
			{recentPosts.map((post) => <PostRow post={post} />)}
		</div>
		<a
			href="/blog"
			class="group mt-6 -mx-2 inline-flex items-center gap-2 rounded-sm px-2 py-1 text-sm text-muted-foreground transition-colors hover:text-primary"
		>
			<span class="text-muted-foreground/70" aria-hidden="true">$</span>
			<span class="underline decoration-border underline-offset-4 group-hover:decoration-primary"
				>cd ~/blog</span
			>
			<span class="text-xs">({posts.length} posts)</span>
		</a>
	</section>
</Layout>
