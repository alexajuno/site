---
import Layout from '../../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import YearHeading from '@/components/YearHeading.astro';
import { getSortedPosts, getYear, type Post } from '@/lib/posts';

const posts = await getSortedPosts();

const postsByYear = posts.reduce<Map<number, Post[]>>((years, post) => {
	const year = getYear(post.data.pubDate);
	years.set(year, [...(years.get(year) ?? []), post]);
	return years;
}, new Map());
---

<Layout title="Writing" description="Writing by alexajuno on software, systems and everything else.">
	<div class="mx-auto max-w-[720px]">
		<header>
			<h1 class="font-serif text-[2.125rem] font-semibold text-heading">writing</h1>
			<p class="mt-1 text-[0.9375rem] text-muted-foreground">{posts.length} posts</p>
		</header>

		{
			[...postsByYear].map(([year, yearPosts]) => (
				<section>
					<YearHeading year={year} count={yearPosts.length} />
					<div class="flex flex-col">
						{yearPosts.map((post) => (
							<PostRow post={post} date="short" />
						))}
					</div>
				</section>
			))
		}
	</div>
</Layout>
