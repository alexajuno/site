---
import Layout from '../../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import Prompt from '@/components/Prompt.astro';
import { getSortedPosts, getYear, type Post } from '@/lib/posts';

const posts = await getSortedPosts();

const postsByYear = posts.reduce<Map<number, Post[]>>((years, post) => {
	const year = getYear(post.data.pubDate);
	years.set(year, [...(years.get(year) ?? []), post]);
	return years;
}, new Map());
---

<Layout title="Blog" description="Writing by alexajuno on software, systems and everything else.">
	<header>
		<Prompt as="h1" command="ls -la ~/blog" label="Blog" />
		<p class="mt-4 text-sm text-muted-foreground">
			{posts.length} posts
		</p>
	</header>

	{
		[...postsByYear].map(([year, yearPosts]) => (
			<section class="mt-12 first:mt-10">
				<h2
					class="flex items-center gap-4 text-sm font-medium text-muted-foreground tabular-nums"
				>
					{year}
					<span class="h-px flex-1 bg-border" aria-hidden="true" />
					<span class="text-xs font-normal">{yearPosts.length}</span>
				</h2>
				<div class="mt-3 flex flex-col">
					{yearPosts.map((post) => (
						<PostRow post={post} />
					))}
				</div>
			</section>
		))
	}
</Layout>
