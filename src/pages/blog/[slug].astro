---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import { getSortedPosts, formatLongDate, type Post } from '@/lib/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			// Sorted newest first, so the previous entry is the newer post.
			newer: posts[index - 1] ?? null,
			older: posts[index + 1] ?? null,
		},
	}));
}

interface Props {
	post: Post;
	newer: Post | null;
	older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

---

<Layout title={post.data.title} description={`${post.data.title} — written ${formatLongDate(post.data.pubDate)}.`}>
	<article class="mx-auto max-w-[680px]">
		<header class="mb-9">
			<time
				datetime={post.data.pubDate.toISOString()}
				class="inline-block rounded-sm bg-date-tint px-2.5 py-0.5 font-mono text-sm text-date tabular-nums"
			>
				{formatLongDate(post.data.pubDate)}
			</time>
			<h1 class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-[2.375rem]">
				{post.data.title}
			</h1>
		</header>

		<div class="prose-post">
			<Content />
		</div>
	</article>

	<nav class="mx-auto mt-14 grid max-w-[680px] gap-4 sm:grid-cols-2" aria-label="More posts">
		{newer ? <PostCard post={newer} label="← newer" /> : <span class="hidden sm:block" />}
		{older && <PostCard post={older} label="older →" align="end" />}
	</nav>
</Layout>
