---
import { createElement } from 'react';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { getSortedPosts, formatLongDate, type Post } from '@/lib/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			// Sorted newest first, so the previous entry is the newer post.
			newer: posts[index - 1] ?? null,
			older: posts[index + 1] ?? null,
		},
	}));
}

interface Props {
	post: Post;
	newer: Post | null;
	older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const neighbours = [
	{ post: newer, label: 'newer', arrow: '←' },
	{ post: older, label: 'older', arrow: '→' },
].filter((neighbour): neighbour is { post: Post; label: string; arrow: string } =>
	Boolean(neighbour.post),
);
---

<Layout title={post.data.title} description={`${post.data.title} — written ${formatLongDate(post.data.pubDate)}.`}>
	<article>
		<header class="border-b pb-8">
			<p class="text-xs text-muted-foreground tabular-nums">
				<time datetime={post.data.pubDate.toISOString()}>
					{formatLongDate(post.data.pubDate)}
				</time>
			</p>
			<h1 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
				{post.data.title}
			</h1>
		</header>

		<div class="prose-terminal mt-10">
			<Content />
		</div>
	</article>

	<nav class="mt-16 border-t pt-8" aria-label="More posts">
		<div class="flex flex-col gap-3">
			{
				neighbours.map(({ post: neighbour, label, arrow }) => (
					<a
						href={`/blog/${neighbour.id}`}
						class="group -mx-2 flex items-baseline gap-3 rounded-sm px-2 py-1.5 transition-colors hover:bg-muted/60"
					>
						<span class="shrink-0 text-xs text-muted-foreground transition-colors group-hover:text-primary">
							{arrow} {label}
						</span>
						<span class="text-sm transition-colors group-hover:text-primary">
							{neighbour.data.title}
						</span>
					</a>
				))
			}
		</div>

		<div class="mt-6 -ml-2.5">
			<Button
				variant="ghost"
				size="sm"
				className="text-muted-foreground"
				render={createElement('a', { href: '/blog' })}
			>
				<span class="text-muted-foreground/70" aria-hidden="true">$</span>
				cd ~/writing
			</Button>
		</div>
	</nav>
</Layout>
