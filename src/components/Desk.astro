---
/**
 * The desk under the lamp: the home page's drawing. It holds only the right
 * end of the desk, where the light falls; the wall and the wood behind it are
 * the hero's own background, so the drawing can sit beside the intro on a wide
 * screen and under it on a phone. Its colours are CSS variables, so the same
 * drawing turns to night in dark mode.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class:list={['desk', className]}
	viewBox="800 0 640 400"
	preserveAspectRatio="xMidYMax meet"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<radialGradient id="desk-glow" cx="1150" cy="170" r="330" gradientUnits="userSpaceOnUse">
			<stop offset="0" class="glow-1"></stop>
			<stop offset=".45" class="glow-2"></stop>
			<stop offset="1" class="glow-3"></stop>
		</radialGradient>
		<radialGradient
			id="desk-pool"
			cx="1120"
			cy="318"
			r="300"
			gradientTransform="matrix(1 0 0 .22 0 248)"
			gradientUnits="userSpaceOnUse"
		>
			<stop offset="0" class="pool-1"></stop>
			<stop offset=".6" class="pool-2"></stop>
			<stop offset="1" class="pool-3"></stop>
		</radialGradient>
		<filter id="desk-soft" x="-20%" y="-50%" width="140%" height="200%">
			<feGaussianBlur stdDeviation="6"></feGaussianBlur>
		</filter>
	</defs>

	<rect x="800" y="0" width="640" height="300" fill="url(#desk-glow)"></rect>
	<ellipse cx="1120" cy="320" rx="300" ry="62" fill="url(#desk-pool)"></ellipse>

	<!-- the lamp -->
	<ellipse class="lamp-base-side" cx="1330" cy="312" rx="42" ry="9"></ellipse>
	<ellipse class="lamp-base" cx="1330" cy="306" rx="42" ry="9"></ellipse>
	<line class="lamp-arm" x1="1330" y1="304" x2="1362" y2="180" stroke-width="7" stroke-linecap="round"></line>
	<line class="lamp-arm" x1="1362" y1="180" x2="1190" y2="84" stroke-width="6" stroke-linecap="round"></line>
	<circle class="lamp-shade" cx="1362" cy="180" r="8"></circle>
	<g transform="translate(1180 92) rotate(30)">
		<path class="lamp-shade" d="M-6 -14 C-34 -8 -48 20 -50 52 L50 52 C48 20 34 -8 6 -14 Z"></path>
		<path class="lamp-shade-dark" d="M14 -8 C34 4 46 26 50 52 L26 52 C27 26 22 8 14 -8 Z"></path>
		<ellipse class="lamp-mouth" cx="0" cy="52" rx="50" ry="13"></ellipse>
		<ellipse class="lamp-halo" cx="0" cy="56" rx="66" ry="20" filter="url(#desk-soft)"></ellipse>
	</g>
	<circle class="lamp-shade" cx="1190" cy="84" r="7"></circle>

	<!-- the laptop, straight on, its screen lit -->
	<polygon class="shadow" points="1010,332 1220,332 1236,342 1022,342"></polygon>
	<rect class="laptop-lid" x="1044" y="196" width="152" height="106" rx="3"></rect>
	<rect class="laptop-screen" x="1052" y="204" width="136" height="90"></rect>
	<line class="screen-here" x1="1064" y1="220" x2="1110" y2="220" stroke-width="3"></line>
	<line class="screen-line" x1="1064" y1="234" x2="1170" y2="234" stroke-width="3"></line>
	<line class="screen-line" x1="1064" y1="248" x2="1156" y2="248" stroke-width="3"></line>
	<line class="screen-line" x1="1064" y1="262" x2="1164" y2="262" stroke-width="3"></line>
	<polygon class="laptop-body" points="1040,302 1200,302 1224,326 1016,326"></polygon>
	<polygon class="laptop-keys" points="1046,306 1194,306 1206,314 1034,314"></polygon>
	<polygon class="laptop-keys" points="1032,316 1208,316 1214,320 1026,320"></polygon>
	<rect class="laptop-keys" x="1096" y="321" width="48" height="4"></rect>
	<rect class="laptop-lid" x="1016" y="326" width="208" height="5"></rect>

	<!-- a mug -->
	<polygon class="shadow" points="928,334 968,334 990,342 950,342"></polygon>
	<rect class="mug" x="928" y="292" width="40" height="44" rx="4"></rect>
	<rect class="mug-side" x="948" y="292" width="20" height="44"></rect>
	<path class="mug-handle" d="M968 304 h10 v22 h-10" fill="none" stroke-width="6"></path>
	<rect class="mug-rim" x="928" y="292" width="40" height="5"></rect>

	<!-- a small plant -->
	<polygon class="shadow" points="866,334 900,334 918,342 884,342"></polygon>
	<polygon class="leaf-1" points="874,298 862,252 884,296"></polygon>
	<polygon class="leaf-2" points="880,298 902,258 892,300"></polygon>
	<polygon class="leaf-3" points="870,300 846,276 878,300"></polygon>
	<rect class="pot" x="864" y="298" width="36" height="36" rx="4"></rect>
	<rect class="pot-side" x="882" y="298" width="18" height="36"></rect>
</svg>

<style>
	.glow-1 { stop-color: var(--glow-1); }
	.glow-2 { stop-color: var(--glow-2); }
	.glow-3 { stop-color: var(--glow-3); stop-opacity: 0; }
	.pool-1 { stop-color: var(--pool-1); }
	.pool-2 { stop-color: var(--pool-2); }
	.pool-3 { stop-color: var(--desk); stop-opacity: 0; }
	.shadow { fill: var(--shadow); opacity: 0.35; }
	.lamp-base { fill: var(--lamp-base); }
	.lamp-base-side { fill: var(--lamp-base-side); }
	.lamp-arm { stroke: var(--lamp); }
	.lamp-shade { fill: var(--lamp-shade); }
	.lamp-shade-dark { fill: var(--lamp-shade-dark); }
	.lamp-mouth { fill: var(--lamp-mouth); }
	.lamp-halo { fill: var(--lamp-mouth); opacity: 0.6; }
	.laptop-lid { fill: var(--laptop-lid); }
	.laptop-screen { fill: var(--paper-50); }
	.screen-here { stroke: var(--clay-500); }
	.screen-line { stroke: var(--paper-400); }
	.laptop-body { fill: var(--laptop-body); }
	.laptop-keys { fill: var(--laptop-keys); }
	.mug { fill: var(--clay-400); }
	.mug-side { fill: var(--clay-500); }
	.mug-handle { stroke: var(--clay-500); }
	.mug-rim { fill: var(--clay-700); }
	.leaf-1 { fill: var(--moss-500); }
	.leaf-2 { fill: var(--moss-400); }
	.leaf-3 { fill: var(--moss-600); }
	.pot { fill: var(--pot); }
	.pot-side { fill: var(--pot-side); }

</style>
