---
interface Props {
	/** The shell command shown on screen. */
	command: string;
	/** Plain-language equivalent, announced in place of the command. */
	label: string;
	/** Headings carry the page outline; `p` is for prompts that aren't one. */
	as?: 'h1' | 'h2' | 'p';
	class?: string;
}

const { command, label, as: Tag = 'h2', class: className } = Astro.props;
---

<Tag
	class:list={[
		'flex items-baseline gap-2 text-sm font-medium tracking-tight',
		className,
	]}
>
	<span class="select-none text-muted-foreground/70" aria-hidden="true">$</span>
	<span class="text-primary" aria-hidden="true">{command}</span>
	<span class="sr-only">{label}</span>
</Tag>
