---
import { formatISODate, formatShortDate, type Post } from '@/lib/posts';

interface Props {
	post: Post;
	/** `short` drops the year, for lists already grouped by it. */
	date?: 'iso' | 'short';
}

const { post, date = 'iso' } = Astro.props;
const shown = date === 'short' ? formatShortDate(post.data.pubDate) : formatISODate(post.data.pubDate);
---

<a
	href={`/blog/${post.id}`}
	class="group -mx-3.5 flex flex-col gap-x-5 gap-y-0.5 rounded-sm px-3.5 py-2 transition-colors hover:bg-muted sm:flex-row sm:items-baseline"
>
	<time
		datetime={post.data.pubDate.toISOString()}
		class:list={[
			'shrink-0 font-mono text-[0.8125rem] text-date tabular-nums',
			date === 'short' ? 'sm:w-14' : 'sm:w-24',
		]}
	>
		{shown}
	</time>
	<span class="text-foreground transition-colors group-hover:text-here-text">
		{post.data.title}
	</span>
</a>
