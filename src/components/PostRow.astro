---
import { formatISODate, type Post } from '@/lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<a
	href={`/blog/${post.id}`}
	class="group -mx-2 flex flex-col gap-x-4 gap-y-0.5 rounded-sm px-2 py-1.5 transition-colors hover:bg-muted/60 sm:flex-row sm:items-baseline"
>
	<time
		datetime={post.data.pubDate.toISOString()}
		class="shrink-0 text-xs text-muted-foreground tabular-nums transition-colors group-hover:text-primary sm:text-sm"
	>
		{formatISODate(post.data.pubDate)}
	</time>
	<span class="text-foreground transition-colors group-hover:text-primary">
		{post.data.title}
	</span>
</a>
